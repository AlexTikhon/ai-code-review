# External transmission is denied unless both this setting and --allow-external are present.
AI_REVIEW_ALLOW_EXTERNAL=false
# Independently opt in to sending private chunks to the embedding endpoint.
AI_REVIEW_ALLOW_EMBEDDINGS=false
OPENAI_API_KEY=
GITHUB_TOKEN=
AI_REVIEW_MODEL=gpt-4o-mini
AI_REVIEW_EMBEDDING_MODEL=text-embedding-3-small
AI_REVIEW_MAX_INPUT_TOKENS=8000
AI_REVIEW_MAX_OUTPUT_TOKENS=1200
